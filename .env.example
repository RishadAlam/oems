APP_NAME=OEMS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oems
DB_USERNAME=oems
DB_PASSWORD=change-me

SESSION_NAME=OEMS_SESSION
REMEMBER_COOKIE=OEMS_REMEMBER

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@oems.local
MAIL_FROM_NAME=OEMS
MAIL_PRIVACY_SINK_ADDRESS=

# Development map defaults. Use traffic-appropriate providers in production.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_DEFAULT_LAT=23.8103
MAP_DEFAULT_LNG=90.4125
MAP_DEFAULT_ZOOM=11
MAP_GEOCODER_URL=https://nominatim.openstreetmap.org/search
MAP_PROVIDER_NAME=OpenStreetMap Nominatim
MAP_USER_AGENT=OEMS/1.0
MAP_CONTACT_EMAIL=
LOCATION_SESSION_TTL=1209600
