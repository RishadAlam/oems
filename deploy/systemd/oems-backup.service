[Unit]
Description=Create a private OEMS database backup
After=mysql.service

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__
EnvironmentFile=__APP_ROOT__/.env
ExecStart=/usr/bin/php __APP_ROOT__/scripts/backup-database.php
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_ROOT__/storage
RestrictSUIDSGID=true
