[Unit]
Description=Reconcile and promote OEMS event waitlists
After=network-online.target mysql.service

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__
EnvironmentFile=__APP_ROOT__/.env
ExecStart=/usr/bin/php __APP_ROOT__/scripts/process-waitlists.php --limit=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_ROOT__/storage
RestrictSUIDSGID=true
