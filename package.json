{
    "name": "oems-frontend",
    "private": true,
    "scripts": {
        "build:assets": "node ./scripts/copy-fonts.mjs && php ./scripts/build-pwa-icons.php",
        "build:css": "npm run build:assets && tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --minify",
        "test:assets": "node ./tests/js/assets.test.mjs",
        "watch:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --watch"
    },
    "devDependencies": {
        "@fontsource-variable/manrope": "^5.3.0",
        "@phosphor-icons/web": "^2.1.2",
        "@tailwindcss/cli": "^4.3.3",
        "chart.js": "4.5.1",
        "leaflet": "^1.9.4",
        "tailwindcss": "^4.3.3"
    }
}
