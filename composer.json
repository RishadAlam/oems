{
    "name": "oems/platform",
    "description": "Online Event Management System built with a custom PHP MVC architecture.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "endroid/qr-code": "^5.1",
        "phpmailer/phpmailer": "^7.0",
        "setasign/fpdf": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "OEMS\\App\\": "app/",
            "OEMS\\Core\\": "Core/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "scripts": {
        "test": "php tests/run.php",
        "check:syntax": "find app Core bootstrap config public routes scripts tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "db:migrate": "@php scripts/database.php migrate",
        "db:rollback": "@php scripts/database.php rollback",
        "db:refresh": "@php scripts/database.php refresh",
        "db:seed": "@php scripts/database.php seed",
        "package:cpanel": [
            "@build",
            "@php scripts/package-cpanel.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
